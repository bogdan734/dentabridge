# make copies this file to .env and fills in the three empty secrets (tools/make_env.py).
# .env stays on this machine (it is gitignored). Delete it to get new keys.
DENTABRIDGE_LIVEKIT_KEY=
DENTABRIDGE_LIVEKIT_SECRET=
DENTABRIDGE_CALL_SECRET=
# where a browser on this machine reaches LiveKit; the API puts it into call tokens
DENTABRIDGE_LIVEKIT_URL=ws://localhost:7880
# the site's origin
DENTABRIDGE_CORS_ORIGINS=http://localhost:3000
