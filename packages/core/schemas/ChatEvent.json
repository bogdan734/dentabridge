{
  "additionalProperties": false,
  "description": "One translated chat message. The source text is always kept.",
  "properties": {
    "digits_ok": {
      "title": "Digits Ok",
      "type": "boolean"
    },
    "glossary_missing": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Glossary Missing",
      "type": "array"
    },
    "message_id": {
      "format": "uuid",
      "title": "Message Id",
      "type": "string"
    },
    "sender": {
      "enum": [
        "patient",
        "dentist"
      ],
      "title": "Sender",
      "type": "string"
    },
    "sent_at": {
      "format": "date-time",
      "title": "Sent At",
      "type": "string"
    },
    "src_lang": {
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "title": "Src Lang",
      "type": "string"
    },
    "src_text": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Src Text",
      "type": "string"
    },
    "tgt_lang": {
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "title": "Tgt Lang",
      "type": "string"
    },
    "tgt_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tgt Text"
    },
    "translation_status": {
      "enum": [
        "ok",
        "failed"
      ],
      "title": "Translation Status",
      "type": "string"
    }
  },
  "required": [
    "message_id",
    "sender",
    "src_lang",
    "tgt_lang",
    "src_text",
    "translation_status",
    "digits_ok",
    "sent_at"
  ],
  "title": "ChatEvent",
  "type": "object"
}
