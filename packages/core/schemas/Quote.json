{
  "$defs": {
    "Money": {
      "additionalProperties": false,
      "properties": {
        "amount_minor": {
          "minimum": 0,
          "title": "Amount Minor",
          "type": "integer"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount_minor",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    },
    "PriceRange": {
      "additionalProperties": false,
      "properties": {
        "high": {
          "$ref": "#/$defs/Money"
        },
        "low": {
          "$ref": "#/$defs/Money"
        },
        "mid": {
          "$ref": "#/$defs/Money"
        }
      },
      "required": [
        "low",
        "mid",
        "high"
      ],
      "title": "PriceRange",
      "type": "object"
    },
    "QuoteLine": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "$ref": "#/$defs/PriceRange"
        },
        "basis_key": {
          "title": "Basis Key",
          "type": "string"
        },
        "chip": {
          "enum": [
            "ESTIMATE",
            "SAMPLE",
            "SIMULATED"
          ],
          "title": "Chip",
          "type": "string"
        },
        "kind": {
          "enum": [
            "treatment",
            "flight",
            "hotel"
          ],
          "title": "Kind",
          "type": "string"
        },
        "trips": {
          "minimum": 1,
          "title": "Trips",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "trips",
        "amount",
        "chip",
        "basis_key"
      ],
      "title": "QuoteLine",
      "type": "object"
    },
    "QuoteRequest": {
      "additionalProperties": false,
      "properties": {
        "clinic_id": {
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Clinic Id",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "depart_date": {
          "format": "date",
          "title": "Depart Date",
          "type": "string"
        },
        "origin_iata": {
          "pattern": "^[A-Z]{3}$",
          "title": "Origin Iata",
          "type": "string"
        },
        "return_date": {
          "format": "date",
          "title": "Return Date",
          "type": "string"
        },
        "travellers": {
          "maximum": 6,
          "minimum": 1,
          "title": "Travellers",
          "type": "integer"
        },
        "treatment_codes": {
          "items": {
            "$ref": "#/$defs/TreatmentCode"
          },
          "minItems": 1,
          "title": "Treatment Codes",
          "type": "array"
        }
      },
      "required": [
        "clinic_id",
        "treatment_codes",
        "origin_iata",
        "depart_date",
        "return_date",
        "travellers",
        "currency"
      ],
      "title": "QuoteRequest",
      "type": "object"
    },
    "TreatmentCode": {
      "enum": [
        "consultation",
        "filling",
        "crown",
        "root_canal",
        "implant",
        "scaling"
      ],
      "title": "TreatmentCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "fare_mdape": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fare Mdape"
    },
    "fare_model_version": {
      "title": "Fare Model Version",
      "type": "string"
    },
    "fx_as_of": {
      "format": "date",
      "title": "Fx As Of",
      "type": "string"
    },
    "lines": {
      "items": {
        "$ref": "#/$defs/QuoteLine"
      },
      "minItems": 1,
      "title": "Lines",
      "type": "array"
    },
    "quote_id": {
      "format": "uuid",
      "title": "Quote Id",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/QuoteRequest"
    },
    "total": {
      "$ref": "#/$defs/PriceRange"
    },
    "total_chip": {
      "const": "ESTIMATE",
      "title": "Total Chip",
      "type": "string"
    },
    "valid_until": {
      "format": "date-time",
      "title": "Valid Until",
      "type": "string"
    }
  },
  "required": [
    "quote_id",
    "request",
    "lines",
    "total",
    "total_chip",
    "fx_as_of",
    "fare_model_version",
    "valid_until"
  ],
  "title": "Quote",
  "type": "object"
}
